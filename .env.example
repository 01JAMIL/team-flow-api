# HTTP port the API listens on
PORT=3700

# PostgreSQL connection DSN used by the API
GOOSE_DBSTRING=host=localhost user=postgres password=postgres dbname=gin-api-1 sslmode=disable

# Docker Compose database settings (must match GOOSE_DBSTRING)
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=gin-api-1

# Secret used to sign JWT tokens (change this!)
JWT_SECRET=change_me

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Resend (transactional email)
RESEND_API_KEY=re_xxx

# Github
GITHUB_TOKEN=xxx
